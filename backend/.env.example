# ===== LearnWay backend configuration (copy to .env) =====

# LLM provider: auto | anthropic | openai | mock
#   auto  -> anthropic if ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN is set,
#            else openai if OPENAI_API_KEY is set, else mock (offline demo data)
LEARNWAY_LLM_PROVIDER=auto

# --- Anthropic (official SDK; reads ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN / ANTHROPIC_BASE_URL) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
LEARNWAY_ANTHROPIC_MODEL=claude-opus-5
# Comma separated beta flags some relays require, e.g. context-1m-2025-08-07
# LEARNWAY_ANTHROPIC_BETAS=

# --- OpenAI-compatible (DeepSeek / Qwen(DashScope) / Kimi / Ollama ...) ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# LEARNWAY_OPENAI_MODEL=deepseek-chat

# --- Zhihu content sources ---
# Official 知乎数据开放平台 (hackathon credentials). Leave empty to use the web fallback.
# LEARNWAY_ZHIHU_OPEN_API_BASE=
# LEARNWAY_ZHIHU_OPEN_API_KEY=
# Search backends, in order. Keyed backends are skipped automatically when their key is missing.
#   brave-api  Brave Search API   (BRAVE_SEARCH_API_KEY, free tier at https://brave.com/search/api/)
#   jina       Jina Search        (JINA_API_KEY, returns page text too; https://jina.ai/reader/)
#   brave/so360/bing  anonymous web search restricted to site:zhihu.com (no key; rate limited)
LEARNWAY_ZHIHU_SEARCH_BACKENDS=brave-api,jina,brave,so360,bing
# BRAVE_SEARCH_API_KEY=
# Page reader used to fetch Zhihu article / question text (Jina Reader by default)
LEARNWAY_READER_BASE=https://r.jina.ai
# JINA_API_KEY=

# --- Zhihu OAuth login (测试状态；见 docs/zhihu-oauth.md) ---
# 公网地址，用于拼回调地址与登录后跳转
LEARNWAY_PUBLIC_ORIGIN=http://127.0.0.1:8000
# 会话签名密钥，生产环境务必改成随机长字符串：python -c "import secrets;print(secrets.token_hex(32))"
LEARNWAY_SESSION_SECRET=change-me-in-production
# 以下四项来自知乎 OAuth quickstart；留空则登录入口不显示
# LEARNWAY_ZHIHU_OAUTH_CLIENT_ID=
# LEARNWAY_ZHIHU_OAUTH_CLIENT_SECRET=
# LEARNWAY_ZHIHU_OAUTH_AUTHORIZE_URL=
# LEARNWAY_ZHIHU_OAUTH_TOKEN_URL=
# LEARNWAY_ZHIHU_OAUTH_USERINFO_URL=
# LEARNWAY_ZHIHU_OAUTH_SCOPE=
# 回调地址默认 {PUBLIC_ORIGIN}/api/auth/zhihu/callback，需与知乎后台登记的一致
# LEARNWAY_ZHIHU_OAUTH_REDIRECT_URI=

# --- Storage ---
LEARNWAY_DATABASE_URL=sqlite:///./data/learnway.db
