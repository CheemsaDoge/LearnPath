# ===== LearnPath backend configuration (copy to .env) =====

# LLM provider: auto | anthropic | openai | mock
#   auto  -> anthropic if ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN is set,
#            else openai if OPENAI_API_KEY is set, else mock (offline demo data)
LEARNPATH_LLM_PROVIDER=auto

# --- Anthropic (official SDK; reads ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN / ANTHROPIC_BASE_URL) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
LEARNPATH_ANTHROPIC_MODEL=claude-opus-5
# Comma separated beta flags some relays require, e.g. context-1m-2025-08-07
# LEARNPATH_ANTHROPIC_BETAS=

# --- OpenAI-compatible (DeepSeek / Qwen(DashScope) / Kimi / Ollama ...) ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# LEARNPATH_OPENAI_MODEL=deepseek-chat

# --- Zhihu content sources ---
# 知乎数据开放平台 Access Secret（https://developer.zhihu.com/profile）。配置后搜索/热榜/直答优先走官方接口。
# ZHIHU_ACCESS_SECRET=
# 直答模型：zhida-fast-1p5 | zhida-thinking-1p5 | zhida-agent
LEARNPATH_ZHIDA_MODEL=zhida-fast-1p5
# 热榜缓存秒数（官方热榜每日 100 次额度）
LEARNPATH_HOT_CACHE_SECONDS=1800
# Search backends, in order. Keyed backends are skipped automatically when their key is missing.
#   brave-api  Brave Search API   (BRAVE_SEARCH_API_KEY, free tier at https://brave.com/search/api/)
#   jina       Jina Search        (JINA_API_KEY, returns page text too; https://jina.ai/reader/)
#   brave/so360/bing  anonymous web search restricted to site:zhihu.com (no key; rate limited)
LEARNPATH_ZHIHU_SEARCH_BACKENDS=brave-api,jina,brave,so360,bing
# BRAVE_SEARCH_API_KEY=
# Page reader used to fetch Zhihu article / question text (Jina Reader by default)
LEARNPATH_READER_BASE=https://r.jina.ai
# JINA_API_KEY=

# --- Zhihu OAuth login (测试状态；见 docs/zhihu-oauth.md) ---
# 公网地址，用于拼回调地址与登录后跳转
LEARNPATH_PUBLIC_ORIGIN=http://127.0.0.1:8000
# 会话签名密钥，生产环境务必改成随机长字符串：python -c "import secrets;print(secrets.token_hex(32))"
LEARNPATH_SESSION_SECRET=change-me-in-production
# App ID / App Key 由黑客松项目页面分配；留空则登录入口不显示
# ZHIHU_OAUTH_APP_ID=
# ZHIHU_OAUTH_APP_KEY=
# 回调地址默认 {PUBLIC_ORIGIN}/api/auth/zhihu/callback，必须与活动页面登记的完全一致
# ZHIHU_OAUTH_REDIRECT_URI=

# --- Storage ---
LEARNPATH_DATABASE_URL=sqlite:///./data/learnpath.db
